{
  "manifest_version": 3,
  "name": "Scrapbook Sticky Notes",
  "version": "1.1.0",
  "description": "Floating, draggable sticky notes with custom artwork and handwritten text. Stored locally, exportable to JSON.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Sticky Notes" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["skins.js", "content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["images/*", "fonts/*", "*.png"], "matches": ["<all_urls>"] }
  ]
}
